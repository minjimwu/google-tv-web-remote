[Unit]
Description=Heran Google TV Web Remote Server (Kali Linux)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kali
WorkingDirectory=/path/to/tvremote/backend
ExecStart=/usr/bin/python3 /path/to/tvremote/backend/server.py
Restart=always
RestartSec=5
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
